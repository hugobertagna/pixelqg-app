# PixelQG terminal (bash, macOS / Linux): started with --rcfile pointing here. Loads your usual
# ~/.bashrc, then makes `claude` go through the PixelQG relay even if ~/.bashrc put another folder
# in front of server/shim in PATH.
if [ -f "$HOME/.bashrc" ]; then
  . "$HOME/.bashrc"
fi
unalias claude 2>/dev/null
function claude {
  if [ -n "$PIXELQG_NODE" ] && [ -n "$PIXELQG_SHIM" ]; then
    "$PIXELQG_NODE" "$PIXELQG_SHIM" "$@"
  else
    command claude "$@"
  fi
}
